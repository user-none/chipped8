    v0 += 8
    if v0 != 124 then jump g9-c4b

    # === ROW 5 (y=50): Additional row - gradient/mixed ===
    # Left: diagonal pattern, Right: all 4 colors in columns
    plane 1
    i := g9-diag
    v1 := 50
    v0 := 4
: g9-d2
    sprite v0 v1 8
    v0 += 8
    if v0 != 60 then jump g9-d2
    # 4-color columns on right
    i := g9-solid
    v0 := 60
: g9-4col
    plane 1
    sprite v0 v1 8
    v0 += 8
    plane 2
    sprite v0 v1 8
    v0 += 8
    plane 3
    sprite v0 v1 8
    v0 += 8
    plane 1
    v0 += 8
    if v0 != 124 then jump g9-4col

    # === Blink block at right side (same row as color blocks) ===
    vA := 108
    vB := 10
    vC := 3
: g9-lp
    plane 1
    i := g9-solid
    sprite vA vB 8
    vE := 30
    delay := vE
: g9-w1
    vE := delay
    if vE != 0 then jump g9-w1
    sprite vA vB 8
    plane 2
    sprite vA vB 8
    vE := 30
    delay := vE
: g9-w2
    vE := delay
    if vE != 0 then jump g9-w2
    sprite vA vB 8
    plane 1
    sprite vA vB 8
    plane 2
    sprite vA vB 8
    vE := 30
    delay := vE
: g9-w3
    vE := delay
    if vE != 0 then jump g9-w3
    plane 1
    sprite vA vB 8
    plane 2
    sprite vA vB 8
    vE := 30
    delay := vE
: g9-w4
    vE := delay
    if vE != 0 then jump g9-w4
    vC += -1
    if vC != 0 then jump g9-lp
    plane 3
    clear
    plane 1
    return


: show-results-screen-01
    # Save results to vD, vE
    vD := v0    # Group 0 results
    vE := v1    # Group 1 results

    # Draw "OP 0" header
    draw-op-header
    v0 := 0
    i := hex v0
    sprite v8 v9 5

    # Row 1 (y=10): 00E0, 1NNN, 2NNN
    v8 := 2
    v9 := 10
    vC := OP_00E0
    draw-opcode
    vA := vD
    vB := 1
    vA &= vB
    draw-result-indicator

    v8 := 44
