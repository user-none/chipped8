# XO-CHIP Test ROM
#
# Register allocation:
#   v0-v6: Scratch for tests
#   v7: Results bitmask (6 bits, one per test)
#   v8-v9: X/Y coordinates for drawing
#   vA-vD: Additional scratch
#   vE: Timer/counter
#   vF: Hardware flag register

# Constants for Opcode Display System

# Character constants for opcode data
:const CHR_N 16
:const CHR_X 17
:const CHR_Y 18
:const CHR_S 19
:const CHR_K 20
:const CHR_I 21
:const CHR_P 22
:const CHR_D 23
:const CHR_R 24
:const CHR_A 25
:const CHR_W 26
:const CHR_O 27
:const CHR_V 28
:const CHR_E 29
:const CHR_M 30
:const CHR_SPC 31

# Opcode ID constants
:const OP_00E0 0
:const OP_1NNN 1
:const OP_2NNN 2
:const OP_00EE 3
:const OP_6XNN 4
:const OP_7XNN 5
:const OP_8XY0 6
:const OP_8XY1 7
:const OP_8XY2 8
:const OP_8XY3 9
:const OP_8XY4 10
:const OP_8XY5 11
:const OP_8XY6 12
:const OP_8XY7 13
:const OP_8XYE 14
:const OP_3XNN 15
:const OP_4XNN 16
:const OP_5XY0 17
:const OP_5XY2 18
:const OP_5XY3 19
:const OP_9XY0 20
:const OP_ANNN 21
:const OP_BNNN 22
:const OP_DXYN 23
:const OP_FX07 24
:const OP_FX15 25
:const OP_FX1E 26
:const OP_FX29 27
:const OP_FX30 28
:const OP_FX33 29
:const OP_FX55 30
:const OP_FX65 31
:const OP_FX75 32
:const OP_FX85 33
:const OP_00CN 34
:const OP_00DN 35
:const OP_00FB 36
:const OP_00FC 37
:const OP_00FE 38
:const OP_00FF 39
:const OP_F000 40
:const OP_FN01 41
:const OP_SKIP 42
:const OP_DRAW 43
:const OP_XOR  44
:const OP_MOVE 45
:const OP_OVER 46
:const OP_WRAP 47
:const OP_DXY0 48

# Entry Point - Jump over data section
: main
    jump main-code

# DATA SECTION - All sprite and table data (placed early for i := access)

# Test data used by Group 3
: test-data-byte
    0xAB 0xCD

: test-sprite
    0x80   # Single pixel

# Buffers for Group 4
: bcd-buffer
    0 0 0

: save-buffer
    0 0 0 0

: load-test-data
    0xAA 0xBB 0xCC

# Buffers for Group 5
: range-buffer
    0 0 0 0

: range-test-data
    0xDD 0xEE 0xFF

# Buffer to store group results (one byte per group)
: group-results
    0 0 0 0 0 0 0 0

# Audio Data - XO-CHIP sound
# Square wave pattern for notes
: waveform
    0x00 0x00 0xFF 0xFF 0x00 0x00 0xFF 0xFF
    0x00 0x00 0xFF 0xFF 0x00 0x00 0xFF 0xFF

# Silence pattern for rests
: silence
    0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
    0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00


# Data for Group 6
: long-test-data
    0x77

# Group 9 sprite patterns
: g9-solid
    0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF
: g9-outline
    0xFF 0x81 0x81 0x81 0x81 0x81 0x81 0xFF
: g9-hstripe
    0xFF 0x00 0xFF 0x00 0xFF 0x00 0xFF 0x00
: g9-hstripe2
    0x00 0xFF 0xFF 0x00 0x00 0xFF 0xFF 0x00
: g9-vstripe
    0xAA 0xAA 0xAA 0xAA 0xAA 0xAA 0xAA 0xAA
: g9-vstripe2
    0x66 0x66 0x66 0x66 0x66 0x66 0x66 0x66
: g9-check
    0xAA 0x55 0xAA 0x55 0xAA 0x55 0xAA 0x55
: g9-check2
    0x66 0x66 0xCC 0xCC 0x66 0x66 0xCC 0xCC
: g9-diag
    0x80 0x40 0x20 0x10 0x08 0x04 0x02 0x01

# Opcode data table: 4 bytes per opcode (character codes)
# Character codes: 0-15 = hex, 16=N, 17=X, 18=Y, 19=S, 20=K, 21=I, 22=P,
#                  23=D, 24=R, 25=A, 26=W, 27=O, 28=V, 29=E, 30=M, 31=space
: opcode-data
    0    0    0x0E 0       # 00E0
    1    16   16   16      # 1NNN
    2    16   16   16      # 2NNN
    0    0    0x0E 0x0E    # 00EE
    6    17   16   16      # 6XNN
    7    17   16   16      # 7XNN
    8    17   18   0       # 8XY0
    8    17   18   1       # 8XY1
    8    17   18   2       # 8XY2
    8    17   18   3       # 8XY3
    8    17   18   4       # 8XY4
    8    17   18   5       # 8XY5
    8    17   18   6       # 8XY6
    8    17   18   7       # 8XY7
    8    17   18   0x0E    # 8XYE
    3    17   16   16      # 3XNN
    4    17   16   16      # 4XNN
    5    17   18   0       # 5XY0
    5    17   18   2       # 5XY2
    5    17   18   3       # 5XY3
    9    17   18   0       # 9XY0
    0x0A 16   16   16      # ANNN
    0x0B 16   16   16      # BNNN
    0x0D 17   18   16      # DXYN
    0x0F 17   0    7       # FX07
    0x0F 17   1    5       # FX15
    0x0F 17   1    0x0E    # FX1E
    0x0F 17   2    9       # FX29
    0x0F 17   3    0       # FX30
    0x0F 17   3    3       # FX33
    0x0F 17   5    5       # FX55
    0x0F 17   6    5       # FX65
    0x0F 17   7    5       # FX75
    0x0F 17   8    5       # FX85
    0    0    0x0C 16      # 00CN
    0    0    0x0D 16      # 00DN
    0    0    0x0F 0x0B    # 00FB
    0    0    0x0F 0x0C    # 00FC
    0    0    0x0F 0x0E    # 00FE
    0    0    0x0F 0x0F    # 00FF
    0x0F 0    0    0       # F000
    0x0F 16   0    1       # FN01
    19   20   21   22      # SKIP
    23   24   25   26      # DRAW
    17   27   24   31      # XOR (space at end)
    30   27   28   29      # MOVE
    27   28   29   24      # OVER
    26   24   25   22      # WRAP
    0x0D 17   18   0       # DXY0

# Letter sprite table (5 bytes each, indexed by letter code - 16)
# Order: N, X, Y, S, K, I, P, D, R, A, W, O, V, E, M
: letter-table
    # N (index 0)
    0xA0   # X.X.
    0xE0   # XXX.
    0xE0   # XXX.
    0xA0   # X.X.
    0xA0   # X.X.
    # X (index 1)
    0xA0   # X.X.
    0xA0   # X.X.
    0x40   # .X..
    0xA0   # X.X.
    0xA0   # X.X.
    # Y (index 2)
    0xA0   # X.X.
    0xA0   # X.X.
    0x40   # .X..
    0x40   # .X..
    0x40   # .X..
    # S (index 3)
    0x60   # .XX.
    0x80   # X...
    0x60   # .XX.
    0x20   # ..X.
    0xC0   # XX..
    # K (index 4)
    0xA0   # X.X.
    0xA0   # X.X.
    0xC0   # XX..
    0xA0   # X.X.
    0xA0   # X.X.
    # I (index 5)
    0xE0   # XXX.
    0x40   # .X..
    0x40   # .X..
    0x40   # .X..
    0xE0   # XXX.
    # P (index 6)
    0xC0   # XX..
    0xA0   # X.X.
    0xC0   # XX..
    0x80   # X...
    0x80   # X...
    # D (index 7)
    0xC0   # XX..
    0xA0   # X.X.
    0xA0   # X.X.
    0xA0   # X.X.
    0xC0   # XX..
    # R (index 8)
    0xC0   # XX..
    0xA0   # X.X.
    0xC0   # XX..
    0xA0   # X.X.
    0xA0   # X.X.
    # A (index 9)
    0x40   # .X..
    0xA0   # X.X.
    0xE0   # XXX.
    0xA0   # X.X.
    0xA0   # X.X.
    # W (index 10)
    0xA0   # X.X.
    0xA0   # X.X.
    0xA0   # X.X.
    0xE0   # XXX.
    0xA0   # X.X.
    # O (index 11)
    0x40   # .X..
    0xA0   # X.X.
    0xA0   # X.X.
    0xA0   # X.X.
    0x40   # .X..
    # V (index 12)
    0xA0   # X.X.
    0xA0   # X.X.
    0xA0   # X.X.
    0xA0   # X.X.
    0x40   # .X..
    # E (index 13)
    0xE0   # XXX.
    0x80   # X...
    0xC0   # XX..
    0x80   # X...
    0xE0   # XXX.
    # M (index 14)
    0xA0   # X.X.
    0xE0   # XXX.
    0xE0   # XXX.
    0xA0   # X.X.
    0xA0   # X.X.

