# Helper to draw "OP " header - leaves v8 positioned for group number
: draw-op-header
    v8 := 52
    v9 := 2

    i := letter-O
    sprite v8 v9 5
    v8 += 5

    i := letter-P
    sprite v8 v9 5
    v8 += 6

    return


# Draw result indicator: checkmark if vA != 0, X if vA == 0
# Adds spacing before indicator and uses different colors for pass/fail
: draw-result-indicator
    v8 += 2    # Add gap between opcode and indicator
    if vA != 0 then jump draw-pass
    # Draw fail (X) in color 2 (plane 2)
    plane 2
    i := sprite-fail
    sprite v8 v9 5
    plane 1    # Reset to default plane
    return
: draw-pass
    # Draw pass (checkmark) in color 1 (plane 1) - already active
    i := sprite-pass
    sprite v8 v9 5
    return


# Opcode Display System - Data-driven approach
# Character codes: 0-15 = hex digits, 16+ = custom letters

# Draw opcode by ID in vC
# Uses v0, v1 as scratch, preserves v8, v9 (position)
: draw-opcode
    # Calculate offset: vC * 4
    v0 := vC
    v1 := vC
    v0 <<= v0    # v0 = vC * 2
    v0 += v1     # v0 = vC * 3
    v0 += v1     # v0 = vC * 4

    # Load 4 character codes
    i := opcode-data
    i += v0
    load v3

    # Draw character 0
    draw-char-v0
    v8 += 5

    # Draw character 1
    v0 := v1
    draw-char-v0
    v8 += 5

    # Draw character 2
    v0 := v2
    draw-char-v0
    v8 += 5

    # Draw character 3
    v0 := v3
    draw-char-v0
    v8 += 5

    return

# Draw single character from code in v0
# Codes 0-15 use hex font, 16-30 use custom letters, 31 = space (skip)
# Note: Uses v4 as scratch to avoid clobbering vD (group results)
: draw-char-v0
    # Check for space
    v4 := 31
    if v0 == v4 then return

    # Check if hex digit (0-15)
    v4 := 16
    if v0 < v4 then jump draw-hex-char

    # Custom letter: calculate offset into letter table
    v0 += -16    # Convert to 0-based letter index
    v4 := v0
    v0 <<= v0    # v0 * 2
    v0 += v4     # v0 * 3
    v0 += v4     # v0 * 4
    v0 += v4     # v0 * 5
    i := letter-table
    i += v0
    sprite v8 v9 5
    return

: draw-hex-char
    i := hex v0
    sprite v8 v9 5
    return


# Finished Screen - Display "DONE"
: show-finished-screen
    v8 := 54
    v9 := 28
    i := letter-D
    sprite v8 v9 5
    v8 += 5
    i := letter-O
    sprite v8 v9 5
    v8 += 5
    i := letter-N
    sprite v8 v9 5
    v8 += 5
    i := letter-E
    sprite v8 v9 5
    return
