    0xF0   # XXXX....

# 16x16 sprite for DXY0 test (32 bytes total: 16 rows x 2 bytes each)
# Box pattern outline
: sprite-16x16
    0xFF 0xFF   # Row 0:  XXXXXXXX XXXXXXXX
    0x80 0x01   # Row 1:  X..............X
    0x80 0x01   # Row 2:  X..............X
    0x80 0x01   # Row 3:  X..............X
    0x80 0x01   # Row 4:  X..............X
    0x80 0x01   # Row 5:  X..............X
    0x80 0x01   # Row 6:  X..............X
    0x80 0x01   # Row 7:  X..............X
    0x80 0x01   # Row 8:  X..............X
    0x80 0x01   # Row 9:  X..............X
    0x80 0x01   # Row 10: X..............X
    0x80 0x01   # Row 11: X..............X
    0x80 0x01   # Row 12: X..............X
    0x80 0x01   # Row 13: X..............X
    0x80 0x01   # Row 14: X..............X
    0xFF 0xFF   # Row 15: XXXXXXXX XXXXXXXX

# CODE SECTION - All executable code starts here
: main-code
    # Enable hi-res mode (128x64)
    hires
    clear

    # Initialize registers
    v7 := 0           # Results bitmask (all fail initially)

    # Show starting screen with 5 already visible
    show-starting-screen
    v8 := 60
    v9 := 35
    v0 := 5
    i := hex v0
    sprite v8 v9 5

    # Start countdown - 5 is already drawn, just play sound and continue
    melody-count-5
    i := hex v0
    sprite v8 v9 5
    countdown-4
    countdown-3
    countdown-2
    countdown-1

    clear

    # Run test groups 0 and 1, save results, display combined
    run-group-0
    i := group-results
    v0 := v7
    save v0 - v0        # Save group 0 result
    run-group-1
    i := group-results
    load v0             # v0 = group 0 result
    v1 := v7            # v1 = group 1 result
    show-results-screen-01

    # Wait 2 seconds
    vE := 120
    delay := vE
: wait-results-01
    vE := delay
    if vE != 0 then jump wait-results-01

    clear

    # Run test groups 2 and 3
    run-group-2
    i := group-results
    v0 := v7
    save v0 - v0        # Save to temp
    run-group-3
    i := group-results
    load v0             # v0 = group 2 result
    v1 := v7            # v1 = group 3 result
    show-results-screen-23

    vE := 120
    delay := vE
: wait-results-23
    vE := delay
    if vE != 0 then jump wait-results-23

    clear

    # Run test groups 4 and 5
    run-group-4
    i := group-results
    v0 := v7
    save v0 - v0
    run-group-5
    i := group-results
    load v0             # v0 = group 4 result
    v1 := v7            # v1 = group 5 result
    show-results-screen-45

    vE := 120
    delay := vE
: wait-results-45
    vE := delay
    if vE != 0 then jump wait-results-45

    clear

    # Run test groups 6 and 7
    run-group-6
    i := group-results
    v0 := v7
    save v0 - v0
    run-group-7
    i := group-results
    load v0             # v0 = group 6 result
    v1 := v7            # v1 = group 7 result
    show-results-screen-67

    vE := 120
    delay := vE
: wait-results-67
    vE := delay
    if vE != 0 then jump wait-results-67

    clear

    # Run test group 8 (Sprite tests - displays for 6 seconds)
    run-group-8

    clear

    # Run test group 9 (Color demos)
    run-group-9

    clear

    # Show finished screen
    show-finished-screen

    # Play finished melody
    melody-finished

    # Infinite loop
: halt-loop
    jump halt-loop


# Starting Screen - Display "STARTING"
: show-starting-screen
    v8 := 44
    v9 := 20
    i := letter-S
    sprite v8 v9 5
    v8 += 5
    i := letter-T
    sprite v8 v9 5
    v8 += 5
    i := letter-A
    sprite v8 v9 5
    v8 += 5
    i := letter-R
    sprite v8 v9 5
    v8 += 5
    i := letter-T
    sprite v8 v9 5
    v8 += 5
    i := letter-I
    sprite v8 v9 5
    v8 += 5
    i := letter-N
    sprite v8 v9 5
    v8 += 5
    i := letter-G
    sprite v8 v9 5
    return


# Countdown Display - Draw number, play sound, erase
# v0 = number to display
: do-countdown
    v8 := 60
    v9 := 35
    i := hex v0
    sprite v8 v9 5
    return

: do-countdown-erase
    v8 := 60
    v9 := 35
    i := hex v0
    sprite v8 v9 5
    return

: countdown-4
    v0 := 4
    do-countdown
    melody-count-4
    do-countdown-erase
    return

: countdown-3
    v0 := 3
    do-countdown
    melody-count-3
    do-countdown-erase
    return

: countdown-2
    v0 := 2
    do-countdown
    melody-count-2
    do-countdown-erase
    return

: countdown-1
    v0 := 1
    do-countdown
    melody-count-1
    do-countdown-erase
    return


# Audio/Music System - XO-CHIP
# Based on Octo xomusicplayer2.8o example

# Silence/rest note
: ---
    i := silence
    jump play

# Play routine - plays current note for duration
: note
    pitch := vF
    i := waveform
: play
    audio
    vF := 40       # Note duration (frames)
    delay := vF
    buzzer := vF   # Sound duration matches delay
: play-wait
    vF := delay
    if vF != 0 then jump play-wait
    return

# Short tone for countdown - brief beep then silence
: tone
    pitch := vF
    i := waveform
    audio
    vF := 10       # Short beep (10 frames)
    buzzer := vF
    vF := 50       # Total wait time (includes silence)
    delay := vF
: tone-wait
    vF := delay
    if vF != 0 then jump tone-wait
    return

# Note definitions (pitch values for different frequencies)
: G-3  vF := 98   jump note   # 196hz
: A-3  vF := 104  jump note   # 220hz
: C-4  vF := 115  jump note   # 262hz
: D-4  vF := 123  jump note   # 293hz
: E-4  vF := 131  jump note   # 330hz
: F-4  vF := 139  jump note   # 349hz
: G-4  vF := 147  jump note   # 392hz
: A-4  vF := 156  jump note   # 440hz
: B-4  vF := 165  jump note   # 494hz
: C-5  vF := 175  jump note   # 523hz
: D-5  vF := 185  jump note   # 587hz
: E-5  vF := 196  jump note   # 659hz

# Short tones for countdown (descending pitches)
: melody-count-5
    vF := 196
    jump tone

: melody-count-4
    vF := 165
    jump tone

: melody-count-3
    vF := 147
    jump tone

: melody-count-2
    vF := 123
    jump tone

: melody-count-1
    vF := 104
    jump tone

# Celebratory finish melody
: melody-finished
    C-4 E-4 G-4 C-5 --- C-5 B-4 C-5 ---
    E-5 D-5 C-5 G-4 --- A-4 B-4 C-5 ;


# Test Group 0 - Basic Instructions
# Tests: 00E0 (clear), 1NNN (jump), 2NNN (call), 00EE (return), 6XNN (set), 7XNN (add)
: run-group-0
    v7 := 0     # Reset results bitmask

    # Test 1: 00E0 (clear) - If we get here, clear works (already used above)
    # We'll mark it pass if we successfully reach this point
    v7 := 1     # Test 1 passed (bit 0)

    # Test 2: 1NNN (jump) - Jump to a label and verify we get there
    v0 := 0          # Will be set to 0x42 if jump works
    jump test-jump-target
: test-jump-return
    if v0 != 0x42 then jump skip-test-2
    vA := 2          # bit 1
    v7 |= vA         # Test 2 passed
: skip-test-2

    # Test 3: 2NNN (call) and Test 4: 00EE (return) - Test together
    v0 := 0
    test-call-subroutine   # Call subroutine that sets v0 = 0x55
    if v0 != 0x55 then jump skip-test-3-4
    vA := 4          # bit 2 - call worked
    v7 |= vA
    vA := 8          # bit 3 - return worked
    v7 |= vA
: skip-test-3-4

    # Test 5: 6XNN (set register)
    v1 := 0x42
    if v1 != 0x42 then jump skip-test-5
    vA := 16         # bit 4
    v7 |= vA
: skip-test-5

    # Test 6: 7XNN (add to register)
    v2 := 5
    v2 += 3
    if v2 != 8 then jump skip-test-6
    vA := 32         # bit 5
    v7 |= vA
: skip-test-6

    return

: test-jump-target
    v0 := 0x42
    jump test-jump-return

: test-call-subroutine
    v0 := 0x55
    return


# Test Group 1 - ALU Operations
# Tests: 8XY0 (mov), 8XY1 (or), 8XY2 (and), 8XY3 (xor), 8XY4 (add), 8XY5 (sub)
: run-group-1
    v7 := 0     # Reset results bitmask

    # Test 1: 8XY0 (mov) - vX := vY
    v0 := 0x37
    v1 := v0
    if v1 != 0x37 then jump skip-g1-test-1
    vA := 1
    v7 |= vA
: skip-g1-test-1

    # Test 2: 8XY1 (or) - vX |= vY
    v0 := 0x0F
    v1 := 0xF0
    v0 |= v1
    if v0 != 0xFF then jump skip-g1-test-2
    vA := 2
    v7 |= vA
: skip-g1-test-2

    # Test 3: 8XY2 (and) - vX &= vY
    v0 := 0xFF
    v1 := 0x0F
    v0 &= v1
    if v0 != 0x0F then jump skip-g1-test-3
    vA := 4
    v7 |= vA
: skip-g1-test-3

    # Test 4: 8XY3 (xor) - vX ^= vY
    v0 := 0xFF
    v1 := 0x0F
    v0 ^= v1
    if v0 != 0xF0 then jump skip-g1-test-4
    vA := 8
    v7 |= vA
: skip-g1-test-4

    # Test 5: 8XY4 (add with carry) - vX += vY, vF = carry
    # Test overflow: 0xFF + 0x02 = 0x01 with carry
    v0 := 0xFF
    v1 := 0x02
    v0 += v1
    if v0 != 0x01 then jump skip-g1-test-5
    if vF != 1 then jump skip-g1-test-5
    vA := 16
    v7 |= vA
: skip-g1-test-5

    # Test 6: 8XY5 (sub with borrow) - vX -= vY, vF = NOT borrow
    # Test: 0x10 - 0x05 = 0x0B, vF = 1 (no borrow)
    v0 := 0x10
    v1 := 0x05
    v0 -= v1
    if v0 != 0x0B then jump skip-g1-test-6
    if vF != 1 then jump skip-g1-test-6
    vA := 32
    v7 |= vA
: skip-g1-test-6

    return


# Test Group 2 - More ALU + Skip Instructions
# Tests: 8XY6 (shr), 8XY7 (subn), 8XYE (shl), 3XNN (skip==), 4XNN (skip!=), 5XY0 (skip VX==VY)
: run-group-2
    v7 := 0

    # Test 1: 8XY6 (shift right) - vX >>= 1, vF = LSB
    # Note: XO-CHIP shifts vX in place (not vY)
    v0 := 0b00000011   # 3, LSB is 1
    v0 >>= v0
    if v0 != 1 then jump skip-g2-test-1
    if vF != 1 then jump skip-g2-test-1
    vA := 1
    v7 |= vA
: skip-g2-test-1

    # Test 2: 8XY7 (subn) - vX = vY - vX, vF = NOT borrow
    # Test: v1(0x10) - v0(0x05) = 0x0B, vF = 1 (no borrow)
    v0 := 0x05
    v1 := 0x10
    v0 =- v1
    if v0 != 0x0B then jump skip-g2-test-2
    if vF != 1 then jump skip-g2-test-2
    vA := 2
    v7 |= vA
: skip-g2-test-2

    # Test 3: 8XYE (shift left) - vX <<= 1, vF = MSB
    v0 := 0b10000001   # 129, MSB is 1
    v0 <<= v0
    if v0 != 2 then jump skip-g2-test-3
    if vF != 1 then jump skip-g2-test-3
    vA := 4
    v7 |= vA
: skip-g2-test-3

    # Test 4: 3XNN (skip if VX == NN)
    v0 := 0x42
    v1 := 0      # Will be set to 1 if skip works
    if v0 == 0x42 then v1 := 1
    if v1 != 1 then jump skip-g2-test-4
    vA := 8
    v7 |= vA
: skip-g2-test-4

    # Test 5: 4XNN (skip if VX != NN)
    v0 := 0x42
    v1 := 0
    if v0 != 0x99 then v1 := 1
    if v1 != 1 then jump skip-g2-test-5
    vA := 16
    v7 |= vA
: skip-g2-test-5

    # Test 6: 5XY0 (skip if VX == VY)
    v0 := 0x42
    v1 := 0x42
    v2 := 0
    if v0 == v1 then v2 := 1
    if v2 != 1 then jump skip-g2-test-6
    vA := 32
    v7 |= vA
: skip-g2-test-6

    return


# Test Group 3 - Skip, Memory, Draw
# Tests: 9XY0 (skip VX!=VY), ANNN (set I), BNNN (jump+v0), DXYN (draw), FX1E (I+=VX), FX07 (get delay)
: run-group-3
    v7 := 0

    # Test 1: 9XY0 (skip if VX != VY)
    v0 := 0x42
    v1 := 0x99
    v2 := 0
    if v0 != v1 then v2 := 1
    if v2 != 1 then jump skip-g3-test-1
    vA := 1
    v7 |= vA
: skip-g3-test-1

    # Test 2: ANNN (set I) - Test by loading known data
    i := test-data-byte
    load v0
    if v0 != 0xAB then jump skip-g3-test-2
    vA := 2
    v7 |= vA
: skip-g3-test-2

    # Test 3: BNNN (jump0) - jump to NNN + v0
    v0 := 2          # Offset
    v1 := 0          # Will be set if jump works
    jump0 jump0-base
: jump0-after
    if v1 != 1 then jump skip-g3-test-3
    vA := 4
    v7 |= vA
: skip-g3-test-3

    # Test 4: DXYN (draw) - Test collision detection
    clear
    v0 := 0
    v1 := 0
    i := test-sprite
    sprite v0 v1 1   # Draw sprite, vF should be 0 (no collision)
    if vF != 0 then jump skip-g3-test-4
    sprite v0 v1 1   # Draw again at same position, vF should be 1 (collision)
    if vF != 1 then jump skip-g3-test-4
    vA := 8
    v7 |= vA
: skip-g3-test-4

    # Test 5: FX1E (I += VX)
    i := test-data-byte
    v0 := 1
    i += v0
    load v0
    if v0 != 0xCD then jump skip-g3-test-5
    vA := 16
    v7 |= vA
: skip-g3-test-5

    # Test 6: FX07 (get delay timer)
    v0 := 10
    delay := v0
    v1 := delay
    # Timer should be 10 or slightly less
    if v1 == 0 then jump skip-g3-test-6
    vA := 32
    v7 |= vA
: skip-g3-test-6

    clear
    return

: jump0-base
    # v0 = 2, so we jump here + 2 bytes = jump0-target
    jump skip-g3-test-3   # Offset 0: fail path
: jump0-target
    v1 := 1               # Offset 2: success path
    jump jump0-after


# Test Group 4 - Timers, Font, BCD, Save/Load
# Tests: FX15 (set delay), FX29 (font addr), FX33 (BCD), FX55 (save), FX65 (load), FX30 (large font)
: run-group-4
    v7 := 0

    # Test 1: FX15 (set delay timer) - Already tested implicitly, verify it decrements
    v0 := 60
    delay := v0
    # Small busy loop
    v1 := 0
: delay-loop
    v1 += 1
    if v1 != 100 then jump delay-loop
    v2 := delay
    # Timer should have decremented
    if v2 == 60 then jump skip-g4-test-1
    vA := 1
    v7 |= vA
: skip-g4-test-1

    # Test 2: FX29 (font address) - Get address of digit 0 font
    v0 := 0
    i := hex v0
    load v0
    # First byte of '0' font should be 0xF0
    if v0 != 0xF0 then jump skip-g4-test-2
    vA := 2
    v7 |= vA
: skip-g4-test-2

    # Test 3: FX33 (BCD) - Convert 123 to BCD
    v0 := 123
    i := bcd-buffer
    bcd v0
    load v2
    if v0 != 1 then jump skip-g4-test-3
    if v1 != 2 then jump skip-g4-test-3
    if v2 != 3 then jump skip-g4-test-3
    vA := 4
    v7 |= vA
: skip-g4-test-3

    # Test 4: FX55 (save registers)
    v0 := 0x11
    v1 := 0x22
    v2 := 0x33
    i := save-buffer
    save v2
    # Clear and reload to verify
    v0 := 0
    v1 := 0
    v2 := 0
    i := save-buffer
    load v2
    if v0 != 0x11 then jump skip-g4-test-4
    if v1 != 0x22 then jump skip-g4-test-4
    if v2 != 0x33 then jump skip-g4-test-4
    vA := 8
    v7 |= vA
: skip-g4-test-4

    # Test 5: FX65 (load registers) - Already tested above, do another
    i := load-test-data
    load v2
    if v0 != 0xAA then jump skip-g4-test-5
    if v1 != 0xBB then jump skip-g4-test-5
    if v2 != 0xCC then jump skip-g4-test-5
    vA := 16
    v7 |= vA
: skip-g4-test-5

    # Test 6: FX30 (large font) - Super-CHIP 10-byte font
    # Just verify the instruction works and returns some font data
    v0 := 0
    i := bighex v0
    load v1    # Load 2 bytes to check font data exists
    # Large '0' font should have non-zero data in first bytes
    if v0 == 0 then jump skip-g4-test-6
    if v1 == 0 then jump skip-g4-test-6
    vA := 32
    v7 |= vA
: skip-g4-test-6

    return


# Test Group 5 - XO-CHIP Memory, Scroll
# Tests: 5XY2 (save range), 5XY3 (load range), 00CN (scroll down), 00FB (scroll right), 00FC (scroll left), 00FE (lores)
: run-group-5
    v7 := 0

    # Ensure default plane is active
    plane 1
    clear

    # Test 1: 5XY2 (save range v1-v3) - XO-CHIP
    v0 := 0x99
    v1 := 0x11
    v2 := 0x22
    v3 := 0x33
    v4 := 0x99
    i := range-buffer
    save v1 - v3
    # Clear and reload
    v1 := 0
    v2 := 0
    v3 := 0
    i := range-buffer
    load v2    # Load 3 bytes into v0-v2
    if v0 != 0x11 then jump skip-g5-test-1
    if v1 != 0x22 then jump skip-g5-test-1
    if v2 != 0x33 then jump skip-g5-test-1
    vA := 1
    v7 |= vA
: skip-g5-test-1

    # Test 2: 5XY3 (load range v1-v3) - XO-CHIP
    i := range-test-data
    load v1 - v3
    if v1 != 0xDD then jump skip-g5-test-2
    if v2 != 0xEE then jump skip-g5-test-2
    if v3 != 0xFF then jump skip-g5-test-2
    vA := 2
    v7 |= vA
: skip-g5-test-2

    # Test 3: 00CN (scroll down N pixels)
    # Draw a pixel, scroll down, check it moved
    clear
    v0 := 0
    v1 := 0
    i := test-sprite
    sprite v0 v1 1   # Draw at (0,0)
    scroll-down 1
    # Pixel should now be at (0,1) - redraw at (0,0) should not collide
    sprite v0 v1 1
    if vF != 0 then jump skip-g5-test-3
    vA := 4
    v7 |= vA
: skip-g5-test-3

    # Test 4: 00FB (scroll right 4 pixels)
    clear
    v0 := 0
    v1 := 0
    i := test-sprite
    sprite v0 v1 1   # Draw at (0,0)
    scroll-right
    # Pixel should have moved right, redraw at (0,0) should not collide
    sprite v0 v1 1
    if vF != 0 then jump skip-g5-test-4
    vA := 8
    v7 |= vA
: skip-g5-test-4

    # Test 5: 00FC (scroll left 4 pixels)
    clear
    v0 := 8
    v1 := 0
    i := test-sprite
    sprite v0 v1 1   # Draw at (8,0)
    scroll-left
    # Pixel should have moved left, redraw at (8,0) should not collide
    sprite v0 v1 1
    if vF != 0 then jump skip-g5-test-5
    vA := 16
    v7 |= vA
: skip-g5-test-5

    # Test 6: 00FE (lores mode) - Switch to 64x32
    lores
    # If no crash, pass
    vA := 32
    v7 |= vA
: skip-g5-test-6

    hires   # Switch back to hires for results display
    plane 1  # Ensure default plane active
    clear
    return


# Test Group 6 - XO-CHIP Display
# Tests: 00FF (hires), 00DN (scroll up), F000 (16-bit I), FN01 (plane), FX75 (save RPL), FX85 (load RPL)
: run-group-6
    v7 := 0

    # Ensure we start with default plane active and clear
    plane 1
    clear

    # Test 1: 00FF (hires mode) - Already in hires, verify no crash
    hires
    vA := 1
    v7 |= vA
: skip-g6-test-1

    # Test 2: 00DN (scroll up N pixels) - XO-CHIP
    clear
    v0 := 0
    v1 := 4
    i := test-sprite
    sprite v0 v1 1   # Draw at (0,4)
    scroll-up 1
    # Pixel should now be at (0,3) - redraw at (0,4) should not collide
    sprite v0 v1 1
    if vF != 0 then jump skip-g6-test-2
    vA := 2
    v7 |= vA
: skip-g6-test-2

    # Test 3: F000 NNNN (16-bit I) - XO-CHIP extended addressing
    i := long-test-data
    load v0
    if v0 != 0x77 then jump skip-g6-test-3
    vA := 4
    v7 |= vA
: skip-g6-test-3

    # Test 4: FN01 (plane N) - XO-CHIP bitplane selection
    # Test that plane instruction works, then reset to plane 1
    plane 3
    clear
    plane 1   # Reset to default plane
    clear
    # If no crash, pass
    vA := 8
    v7 |= vA
: skip-g6-test-4

    # Test 5: FX75 (save to RPL flags) - Save v0-v3 to RPL user flags
    v0 := 0x12
    v1 := 0x34
    v2 := 0x56
    v3 := 0x78
    saveflags v3
    # Clear registers
    v0 := 0
    v1 := 0
    v2 := 0
    v3 := 0
    loadflags v3
    if v0 != 0x12 then jump skip-g6-test-5
    if v1 != 0x34 then jump skip-g6-test-5
    vA := 16
    v7 |= vA
: skip-g6-test-5

    # Test 6: FX85 (load from RPL flags) - Already tested above
    if v2 != 0x56 then jump skip-g6-test-6
    if v3 != 0x78 then jump skip-g6-test-6
    vA := 32
    v7 |= vA
: skip-g6-test-6

    # Ensure default plane is active and clear
    plane 1
    clear
    return


# Test Group 7 - Additional Edge Cases
# Tests: 8XY4 overflow=0, 8XY5 borrow, 8XY7 borrow, DXYN wrap, FX33 edge, skip chain
: run-group-7
    v7 := 0

    # Test 1: 8XY4 no overflow - vF should be 0
    v0 := 0x10
    v1 := 0x20
    v0 += v1
    if v0 != 0x30 then jump skip-g7-test-1
    if vF != 0 then jump skip-g7-test-1
    vA := 1
    v7 |= vA
: skip-g7-test-1

    # Test 2: 8XY5 with borrow - vF should be 0
    v0 := 0x05
    v1 := 0x10
    v0 -= v1
    # 0x05 - 0x10 = 0xF5 (with borrow), vF = 0
    if v0 != 0xF5 then jump skip-g7-test-2
    if vF != 0 then jump skip-g7-test-2
    vA := 2
    v7 |= vA
: skip-g7-test-2

    # Test 3: 8XY7 with borrow - vF should be 0
    v0 := 0x10
    v1 := 0x05
    v0 =- v1
    # v1(0x05) - v0(0x10) = 0xF5 (with borrow), vF = 0
    if v0 != 0xF5 then jump skip-g7-test-3
    if vF != 0 then jump skip-g7-test-3
    vA := 4
    v7 |= vA
: skip-g7-test-3

    # Test 4: FX33 BCD edge case - 255
    v0 := 255
    i := bcd-buffer
    bcd v0
    load v2
    if v0 != 2 then jump skip-g7-test-4
    if v1 != 5 then jump skip-g7-test-4
    if v2 != 5 then jump skip-g7-test-4
    vA := 8
    v7 |= vA
: skip-g7-test-4

    # Test 5: FX33 BCD edge case - 0
    v0 := 0
    i := bcd-buffer
    bcd v0
    load v2
    if v0 != 0 then jump skip-g7-test-5
    if v1 != 0 then jump skip-g7-test-5
    if v2 != 0 then jump skip-g7-test-5
    vA := 16
    v7 |= vA
: skip-g7-test-5

    # Test 6: Multiple consecutive skips
    v0 := 1
    v1 := 1
    v2 := 0
    if v0 == 1 then if v1 == 1 then v2 := 1
    if v2 != 1 then jump skip-g7-test-6
    vA := 32
    v7 |= vA
: skip-g7-test-6

    return


# Test Group 8 - Sprite Tests (Single Page Display)
# Shows all sprite behaviors on one screen with labels
: run-group-8
    v7 := 63    # All tests pass (visual demo)

    hires
    plane 1
    clear

    # Draw "SPRITE" title at top center
    v8 := 42
    v9 := 0
    i := letter-S
    sprite v8 v9 5
    v8 += 5
    i := letter-P
    sprite v8 v9 5
    v8 += 5
    i := letter-R
    sprite v8 v9 5
    v8 += 5
    i := letter-I
    sprite v8 v9 5
    v8 += 5
    i := letter-T
    sprite v8 v9 5
    v8 += 5
    i := letter-E
    sprite v8 v9 5

    # Row 1 (y=8): DRAW - static sprite draw
    v8 := 2
    v9 := 8
    i := letter-D
    sprite v8 v9 5
    v8 += 5
    i := letter-R
    sprite v8 v9 5
    v8 += 5
    i := letter-A
    sprite v8 v9 5
    v8 += 5
    i := letter-W
    sprite v8 v9 5
    # Sprite demo - static draw
    v0 := 30
    v1 := 8
    i := sprite-8x8
    sprite v0 v1 8

    # Row 2 (y=18): XOR label (animation happens in loop below)
    v8 := 2
    v9 := 18
    i := letter-X
    sprite v8 v9 5
    v8 += 5
    i := letter-O
    sprite v8 v9 5
    v8 += 5
    i := letter-R
    sprite v8 v9 5
    # XOR demo: initial draw (will be toggled in animation loop)
    v0 := 30
    v1 := 18
    i := sprite-8x8
    sprite v0 v1 8

    # Row 3 (y=28): HIT - collision detection (overlapping sprites)
    v8 := 2
    v9 := 28
    i := letter-H
    sprite v8 v9 5
    v8 += 5
    i := letter-I
    sprite v8 v9 5
    v8 += 5
    i := letter-T
    sprite v8 v9 5
    # Collision demo: overlapping sprites
    v0 := 30
    v1 := 28
    i := sprite-8x8
    sprite v0 v1 8
    v0 := 34
    v1 := 30
    sprite v0 v1 8

    # Row 4 (y=38): WRAP - edge wrapping (label centered, sprite at edge wraps left)
    v8 := 56
    v9 := 38
    i := letter-W
    sprite v8 v9 5
    v8 += 5
    i := letter-R
    sprite v8 v9 5
    v8 += 5
    i := letter-A
    sprite v8 v9 5
    v8 += 5
    i := letter-P
    sprite v8 v9 5
    # Wrap demo: sprite at screen edge (wraps to left side)
    v0 := 124
    v1 := 38
    i := sprite-8x8
    sprite v0 v1 8

    # Row 5 (y=48): BIG - 16x16 sprite
    v8 := 2
    v9 := 52
    v0 := 0xB
    i := hex v0
    sprite v8 v9 5
    v8 += 5
    i := letter-I
    sprite v8 v9 5
    v8 += 5
    i := letter-G
    sprite v8 v9 5
    # 16x16 sprite demo
    v0 := 30
    v1 := 48
    i := sprite-16x16
    sprite v0 v1 0

    # MOVE label on right side
    v8 := 70
    v9 := 18
    i := letter-M
    sprite v8 v9 5
    v8 += 5
    i := letter-O
    sprite v8 v9 5
    v8 += 5
    i := letter-V
    sprite v8 v9 5
    v8 += 5
    i := letter-E
    sprite v8 v9 5

    # Animate MOVE (smooth) and XOR (slow toggle) independently
    # MOVE: updates every frame for smooth motion
    # XOR: toggles every 30 frames for visible on/off effect
    vA := 70      # MOVE X position
    vB := 28      # MOVE Y position
    vC := 0       # XOR toggle counter
    vD := 180     # Total frames (~6 seconds at ~30fps)
    i := sprite-8x8
: sprite-anim-loop
    # Draw MOVE sprite at current position
    sprite vA vB 8
    # Short delay for smooth movement
    vE := 3
    delay := vE
: sprite-anim-wait
    vE := delay
    if vE != 0 then jump sprite-anim-wait
    # Erase MOVE sprite
    sprite vA vB 8
    # Update MOVE position
    vA += 1
    v0 := 120
    if vA == v0 then vA := 70
    # Check if time to toggle XOR
    vC += 1
    v0 := 30
    if vC != v0 then jump sprite-skip-xor
    # Toggle XOR sprite
    vC := 0
    v0 := 30
    v1 := 18
    sprite v0 v1 8
: sprite-skip-xor
    # Decrement frame counter
    vD += -1
    if vD != 0 then jump sprite-anim-loop
    # Draw final MOVE position
    sprite vA vB 8

    clear
    return


# Test Group 9 - XO-CHIP Color Tests (Full Screen Layout)
